# Node.js 22.12+; backend only. Never add VITE_ to secret variables.
APP_URL="http://127.0.0.1:3000"
HOST="127.0.0.1"
PORT="3000"

# Required for real accounts; leave empty to browse the guest demo.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Rotating this value signs out existing BFF sessions and invalidates unused challenges.
SESSION_SECRET=""

# Optional billing. Exact Stripe Payment Link ID, e.g. plink_..., not the buy.stripe.com URL.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PAYMENT_LINK_ID=""
# Public payment URL must match the link ID above. Rebuild frontend after changing.
VITE_PRO_PAYMENT_URL=""

# Optional LINE: Messaging API credentials; Login channel under the same provider for LIFF.
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ID=""
LIFF_ID=""
# Optional explicitly managed fallback routing: email@example.com:LINE_USER_ID
LINE_RECIPIENTS=""

# Optional email reports and server cron.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
CRON_SECRET=""

# Optional LINE assistant. Backend sends chat and a financial summary to Anthropic.
ANTHROPIC_API_KEY=""
