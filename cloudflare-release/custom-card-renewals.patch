+            <input type="checkbox" className="mt-1 h-4 w-4 accent-orange-400" checked={checkout.saveCard === true}
+              disabled={checkout.autoRenew === true}
+              onChange={e => changeOptions(false, e.target.checked)}/>
+            <span>จำบัตรไว้ใช้ครั้งหน้า<span className="mt-1 block text-xs text-brand-muted">บัตรเก็บอย่างปลอดภัยกับ Stripe การจำบัตรอย่างเดียวจะไม่ตัดเงินอัตโนมัติ</span></span>
+          </label>
+          <label className="flex cursor-pointer items-start gap-3 rounded-xl border border-orange-400/25 p-3 text-sm text-brand-text dark:text-white">
+            <input type="checkbox" className="mt-1 h-4 w-4 shrink-0 accent-orange-400" checked={checkout.autoRenew === true}
