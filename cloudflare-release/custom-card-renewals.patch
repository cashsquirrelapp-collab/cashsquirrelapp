+  const amount = (checkout.amount / 100).toLocaleString('th-TH');
+  const duration = checkout.months === 12 ? '1 ปี' : `${checkout.months} เดือน`;
+  React.useEffect(() => {
+    let canceled = false;
+    let payment: StripePaymentElement | undefined;
+    actions.current = null;
+    setReady(false); setError('');
+    void (async () => {
+      const stripe = await loadStripe(checkout.publishableKey, { locale: 'th' });
+      if (canceled) return;
+      if (!stripe) throw new Error('โหลดช่องกรอกบัตรไม่สำเร็จ');
+      const dark = document.documentElement.classList.contains('dark');
+      const sdk = stripe.initCheckoutElementsSdk({
+        clientSecret: checkout.clientSecret,
+        elementsOptions: {
+          savedPaymentMethod: { enableSave: 'never', enableRedisplay: 'auto' },
+          appearance: {
+            theme: dark ? 'night' : 'stripe',
+            variables: { colorPrimary: '#ffa66b', colorBackground: dark ? '#202124' : '#ffffff',
+              colorText: dark ? '#f3f1ef' : '#292524', colorDanger: '#ef4444',
+              borderRadius: '12px', fontFamily: 'system-ui, sans-serif', spacingUnit: '4px' },
+          },
+        },
+      });
+      const loaded = await sdk.loadActions();
+      if (canceled) return;
+      if (loaded.type !== 'success') throw new Error('โหลดหน้าชำระไม่สำเร็จ กรุณาลองใหม่');
+      actions.current = loaded.actions;
+      payment = sdk.createPaymentElement({ layout: 'tabs' });
+      payment.on('ready', () => { if (!canceled) setReady(true); });
+      payment.on('loaderror', () => { if (!canceled) setError('โหลดช่องกรอกบัตรไม่สำเร็จ กรุณาเปิดหน้านี้อีกครั้ง'); });
+      if (mount.current) payment.mount(mount.current);
