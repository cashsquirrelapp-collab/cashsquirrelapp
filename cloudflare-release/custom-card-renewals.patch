+            <span>{renewalConsentText(checkout.period)}</span>
+          </label>
+        </fieldset>
+        <p className="mt-3 text-xs text-brand-muted">{checkout.autoRenew
+          ? `รอบถัดไป ฿${amount} ทุก${checkout.months === 12 ? 'ปี' : checkout.months === 1 ? 'เดือน' : ' 6 เดือน'} · ปิดการต่ออายุได้`
+          : `จ่ายครั้งเดียว ใช้ Pro ${duration} · ไม่ตัดเงินรอบถัดไป`}</p>
