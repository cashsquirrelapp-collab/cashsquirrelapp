+    transaction({ id: 'txn_refund_failure', reporting_category: 'refund_failure', type: 'adjustment', amount: 5000, fee: 0, net: 5000 }),
+    transaction({ id: 'txn_reversed', amount: 1000, fee: 0, net: 1000 }),
