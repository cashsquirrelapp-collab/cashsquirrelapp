+  await expect(page.getByRole('heading', { name: 'รายการรับชำระล่าสุด' })).toBeVisible();
+  await expect(page.getByRole('heading', { name: 'ประวัติการโอนเข้าธนาคาร' })).toBeVisible();
+});
