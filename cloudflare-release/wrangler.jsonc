{
  "name": "kraroktunngern",
  "keep_vars": true,
  "main": "./app/cloudflare/worker.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_server_modules"
  ],
  "account_id": "7cb26b23e102b0d36824da093b2a267c",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    // Vercel scheduling is disabled before this Cloudflare handoff.
    // The 01:00 daily event also runs monthly jobs on the first day.
    "crons": ["0 1 * * *", "0 2 * * *"]
  },
  "assets": {
    "directory": "./app/build/frontend",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "vars": {
    "AI_ADMINS_ONLY": "false",
    "NODE_ENV": "production",
    "APP_URL": "https://kraroktunngern.cashsquirrelapp.workers.dev",
    "SUPABASE_URL": "https://rcllghixkclvkxhvttaw.supabase.co",
    "STRIPE_MODE": "live",
    "STRIPE_PUBLISHABLE_KEY": "pk_live_51TeotMC4uZ5mcDl1yFqhID6MuHQWeOvuhICamm39Dxm1NfIocYEQr4jTfwGM1smFrVDt3VSHOczX4M9HJdPfzrnL008rqkBAVe",
    "KRAROK_PREPAID_ENABLED": "true",
    "KRAROK_DIRECT_QR_ENABLED": "true",
    "KRAROK_CUSTOM_CARD_ENABLED": "true",
    "CRON_ENABLED": "true"
  },
  "observability": {
    "enabled": true
  }
}
